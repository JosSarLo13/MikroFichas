<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Portal Cautivo Wi-Fi"
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Fichas Sarmientos • Diseño Exclusivo"
                android:textColor="@color/emerald_light"
                android:textSize="11sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnClosePortalDialog"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Cerrar"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            app:tint="@color/text_secondary" />
    </LinearLayout>

    <!-- WebView Frame for Live Preview -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="340dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/bg_dark"
        app:cardCornerRadius="16dp"
        app:cardElevation="0dp">

        <WebView
            android:id="@+id/wvPortalPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvPortalStatusMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@color/surface_dark"
        android:padding="8dp"
        android:textColor="@color/cyan_light"
        android:textSize="11sp"
        android:visibility="gone" />

    <!-- Actions -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnInstallPortal"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:backgroundTint="@color/emerald_accent"
            android:text="Instalar en MikroTik (1 Clic)"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textStyle="bold"
            app:cornerRadius="8dp"
            app:icon="@drawable/ic_portal"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:iconTint="@color/white" />
    </LinearLayout>

</LinearLayout>
